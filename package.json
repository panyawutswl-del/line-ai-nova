{
  "name": "line-ai-nova",
  "version": "0.1.0",
  "private": true,
  "description": "Nova — Personal AI Assistant on LINE (Next.js 15 + Gemini + Supabase)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "line:richmenu:create": "tsx scripts/richmenu.ts create",
    "line:richmenu:delete": "tsx scripts/richmenu.ts delete",
    "line:richmenu:link": "tsx scripts/richmenu.ts link"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@line/bot-sdk": "^9.9.0",
    "@prisma/client": "^6.19.3",
    "@skytrade/ai-summary": "file:../skytrade/packages/ai-summary",
    "@skytrade/analysis-engine": "file:../skytrade/packages/analysis-engine",
    "@skytrade/nova-skytrade-module": "file:../skytrade/packages/nova-skytrade-module",
    "@skytrade/pipeline-scheduler": "file:../skytrade/packages/scheduler",
    "@skytrade/telegram-bot": "file:../skytrade/packages/telegram-bot",
    "@skytrade/telegram-formatter": "file:../skytrade/packages/telegram-formatter",
    "@skytrade/tradingview-mcp": "file:../skytrade/packages/tradingview-mcp",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.5",
    "tradingview-mcp-server": "^0.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prisma": "^6.19.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.5": true
  }
