# ============================================================
# Nova — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit .env)
# ============================================================

# ----- Supabase PostgreSQL -----
# Supabase Dashboard → Connect (ปุ่มบนขวา) → ORMs → Prisma
# DATABASE_URL = Transaction pooler (port 6543) — ใช้ตอน runtime บน Vercel
# DIRECT_URL   = Direct connection (port 5432) — ใช้ตอนรัน migration
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""

# ----- Google Gemini (Google AI Studio) -----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ----- LINE Messaging API -----
# LINE Developers Console → channel → Basic settings → Channel secret
LINE_CHANNEL_SECRET=""
# LINE Developers Console → channel → Messaging API → Channel access token → Issue
LINE_CHANNEL_ACCESS_TOKEN=""

# ----- Whitelist Auth (Phase 1) -----
# LINE User ID ของเจ้าของ (ขึ้นต้นด้วย U...) — ทักบอทครั้งแรก บอทจะตอบ ID กลับมา
OWNER_LINE_USER_ID=""

# ----- Cron protection (Phase 2) -----
# สุ่ม string ยาว ๆ (เช่น `openssl rand -hex 24`) — Vercel Cron ส่ง header ให้อัตโนมัติ
# external pinger ต้องส่ง header: Authorization: Bearer <ค่านี้>
CRON_SECRET=""

# ============================================================
# Optional
# ============================================================

# model อื่นใช้ไม่ได้บน free tier (2.0-flash → 429, 1.5-flash → 404)
GEMINI_MODEL="gemini-2.5-flash"

# User ID เพิ่มเติมที่อนุญาตให้ใช้บอท คั่นด้วย comma
WHITELIST_LINE_USER_IDS=""

# ----- Google Calendar (Phase 2 — optional, เว้นว่างได้ถ้ายังไม่ใช้) -----
# ดู docs/google-calendar-oauth.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# ต้องเป็น https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# ----- Weather location (Phase 3 — optional, default = สุโขทัย) -----
# ใช้ในสรุปเช้า (Open-Meteo, ไม่ต้องมี API key)
WEATHER_LATITUDE="17.0078"
WEATHER_LONGITUDE="99.8237"
WEATHER_LOCATION_NAME="สุโขทัย"
